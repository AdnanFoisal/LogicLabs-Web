#include <windows.h>

1 ICON "../../desktop-app/src/main/resources/icon.ico"
1 RT_MANIFEST "LogicLabs.exe.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,2,0
 PRODUCTVERSION 1,1,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Logic Labs (GPL-3.0)"
            VALUE "FileDescription", "Logic Labs — IDL-800A Digital Electronics Workstation"
            VALUE "FileVersion", "1.1.3.0"
            VALUE "InternalName", "LogicLabs"
            VALUE "LegalCopyright", "GPL-3.0-only · Original by Adnan Foisal (CUET CSE)"
            VALUE "OriginalFilename", "LogicLabs.exe"
            VALUE "ProductName", "Logic Labs"
            VALUE "ProductVersion", "1.1.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
